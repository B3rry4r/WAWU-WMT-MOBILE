{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/feed/**",
              "components/identity/**",
              "components/inbox/**",
              "components/money/**",
              "components/navigation/**",
              "explorations/**",
              "guidelines/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Alan Sans))/i]",
        "message": "Font not provided by the design system. Available: Alan Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Amount'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|currency|size|weight|decimals|sign|color|masked|style|key|ref|className|style|children)$/]",
        "message": "<Amount> doesn't accept that prop. Declared props: value, currency, size, weight, decimals, sign, color, masked, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|initial|src|size|hue|ring|accent|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, initial, src, size, hue, ring, accent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='hue'] > Literal[value!=/^(?:lilac|lemon|green|sky|pink|coral|sand)$/]",
        "message": "<Avatar> hue must be one of 'lilac' | 'lemon' | 'green' | 'sky' | 'pink' | 'coral' | 'sand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BalanceAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|key|ref|className|style|children)$/]",
        "message": "<BalanceAction> doesn't accept that prop. Declared props: icon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|full|disabled|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, full, disabled, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|white|glass)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'white' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|count|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, selected, count, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConversationRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|hue|avatar|leading|preview|time|unread|kind|style|key|ref|className|style|children)$/]",
        "message": "<ConversationRow> doesn't accept that prop. Declared props: name, hue, avatar, leading, preview, time, unread, kind, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConversationRow'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:money|dm|request)$/]",
        "message": "<ConversationRow> kind must be one of 'money' | 'dm' | 'request'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerifiedTicks'] > JSXAttribute > JSXIdentifier[name!=/^(?:creator|professional|size|onMedia|style|key|ref|className|style|children)$/]",
        "message": "<VerifiedTicks> doesn't accept that prop. Declared props: creator, professional, size, onMedia, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|height|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: placeholder, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:tab|background|blur|scrim|children|style|key|ref|className|style|children)$/]",
        "message": "<FeedFrame> doesn't accept that prop. Declared props: tab, background, blur, scrim, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HomeTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onDark|onChange|style|key|ref|className|style|children)$/]",
        "message": "<HomeTabs> doesn't accept that prop. Declared props: value, onDark, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|stroke|color|fill|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, stroke, color, fill, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:platform|handle|key|ref|className|style|children)$/]",
        "message": "<SocialLink> doesn't accept that prop. Declared props: platform, handle."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|caption|action|onAction|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: title, caption, action, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|badges|onDark|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: active, badges, onDark, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TgifCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:verse|onOpen|style|key|ref|className|style|children)$/]",
        "message": "<TgifCard> doesn't accept that prop. Declared props: verse, onOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TxIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|size|key|ref|className|style|children)$/]",
        "message": "<TxIcon> doesn't accept that prop. Declared props: icon, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='TxIcon'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|in|accent)$/]",
        "message": "<TxIcon> tone must be one of 'neutral' | 'in' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TypeTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|light|style|key|ref|className|style|children)$/]",
        "message": "<TypeTag> doesn't accept that prop. Declared props: icon, children, light, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
