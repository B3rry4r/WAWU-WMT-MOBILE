{
  "expo": {
    "name": "Who Made This",
    "slug": "wawu-wmt",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wawu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "africa.wawu.wmt",
      "supportsTablet": false
    },
    "android": {
      "package": "africa.wawu.wmt",
      "adaptiveIcon": {
        "backgroundColor": "#9411C9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_SETTINGS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0A0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-image",
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to approve payments."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to take the selfie that opens your wallet.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to open your photos so you can choose a profile picture or add photos and videos to your works.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save a picture to your photos when you choose Save.",
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#9411C9"
        }
      ],
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Allow $(PRODUCT_NAME) to add an event you have a ticket for to your calendar.",
          "calendarPermission": "Allow $(PRODUCT_NAME) to add an event you have a ticket for to your calendar.",
          "remindersPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-video",
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "moxnafrica",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d07de585-f201-4b3e-989a-34f948d6e860"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/d07de585-f201-4b3e-989a-34f948d6e860"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
