{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.invalid",
        "EXPO_PUBLIC_ID_URL": "https://id.staging.invalid"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.invalid",
        "EXPO_PUBLIC_ID_URL": "https://id.staging.invalid"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://production.invalid",
        "EXPO_PUBLIC_ID_URL": "https://id.production.invalid"
      }
    }
  }
}
